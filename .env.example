# Database
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5433/virtual_football

# Auth
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Simulation
MATCH_DURATION_SECONDS=480

# Wallet (test tokens, minor units)
INITIAL_WALLET_MINOR=1000000

# Stake limits (minor units)
MIN_STAKE_MINOR=10
MAX_STAKE_MINOR=500000

# --- Vercel monolith deployment ---
# Neon / Vercel Postgres URL (postgres://... ?sslmode=require is accepted as-is)
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=change-me
# Frontend: leave unset in production (defaults to same-origin /api).
# For local dev against standalone uvicorn:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
